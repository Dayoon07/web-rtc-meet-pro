# deploy/.env 로 복사해서 채운다. .env 는 커밋하지 않는다 (.gitignore)

# 서비스 도메인. 도메인이 없으면 공인 IP 로 만든 sslip.io 주소를 써도 https 인증서가 나온다 (예: 211-37-1-23.sslip.io)
DOMAIN=211-37-1-23.sslip.io
# 관리자 사이트 주소 (DNS 에서 같은 VM 공인 IP 로). sslip.io 는 앞에 admin. 만 붙이면 된다
ADMIN_DOMAIN=admin.211-37-1-23.sslip.io
# VM 의 공인 IP (WebRTC 미디어가 직접 붙는 주소)
PUBLIC_IP=211.37.1.23

# 비밀값: 각각 다른 긴 무작위 문자열 (예: openssl rand -base64 48)
ORACLE_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
MEDIA_JWT_SECRET=
MEDIA_INTERNAL_SECRET=

# 구글 로그인 (비우면 구글 버튼 비활성). 승인된 리디렉션 URI: https://<DOMAIN>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 메일 (비밀번호 재설정·팀 초대). 비우면 메일을 보내지 않고 서버 로그에만 남긴다
# Gmail: smtp.gmail.com / 587 / 구글 계정 "앱 비밀번호" (2단계 인증 필요). 하루 발송량 제한이 있다
# 네이버: smtp.naver.com / 587 / 네이버 메일 설정에서 SMTP 사용 켜기
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 보내는 사람 (SMTP 계정 주소와 같아야 스팸 처리가 덜 된다). 예: Limeet <limeet.help@gmail.com>
MAIL_FROM=

# mediasoup 워커 수 (CPU 코어 수 이하)
MEDIASOUP_WORKERS=2

# (선택) 백업을 S3 에도 올릴 때 (deploy/backup.sh). 서버에 aws CLI 설정이 필요하다
# BACKUP_S3_URI=s3://버킷이름/limeet
