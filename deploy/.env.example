# deploy/.env 로 복사해서 채운다. .env 는 커밋하지 않는다 (.gitignore)

# 서비스 도메인. 도메인이 없으면 공인 IP 로 만든 sslip.io 주소를 써도 https 인증서가 나온다 (예: 211-37-1-23.sslip.io)
DOMAIN=211-37-1-23.sslip.io
# 관리자 사이트 주소 (DNS 에서 같은 VM 공인 IP 로). sslip.io 는 앞에 admin. 만 붙이면 된다
ADMIN_DOMAIN=admin.211-37-1-23.sslip.io
# VM 의 공인 IP (WebRTC 미디어가 직접 붙는 주소)
PUBLIC_IP=211.37.1.23

# 함께 띄울 것: oracle(DB 컨테이너), ollama(무료 AI). Oracle 을 서버에 직접 설치했으면 oracle 을 빼고 DB_URL 을 아래처럼
COMPOSE_PROFILES=oracle
# DB_URL=jdbc:oracle:thin:@//host.docker.internal:1521/FREEPDB1

# 비밀값: 각각 다른 긴 무작위 문자열 (예: openssl rand -base64 48)
ORACLE_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
MEDIA_JWT_SECRET=
MEDIA_INTERNAL_SECRET=

# 구글 로그인 (비우면 구글 버튼 비활성). 승인된 리디렉션 URI: https://<DOMAIN>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 메일 (비밀번호 재설정·팀 초대). 비우면 메일을 보내지 않고 서버 로그에만 남긴다
# Gmail: smtp.gmail.com / 587 / 구글 계정 "앱 비밀번호" (2단계 인증 필요). 하루 발송량 제한이 있다
# 네이버: smtp.naver.com / 587 / 네이버 메일 설정에서 SMTP 사용 켜기
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 보내는 사람 (SMTP 계정 주소와 같아야 스팸 처리가 덜 된다). 예: MQ <limeet.help@gmail.com>
MAIL_FROM=

# 토스페이먼츠 자동결제 (개발자센터 → API 키 → API 개별 연동 키). 운영은 live_ck_ / live_sk_
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 카드 빌링키 암호화 비밀값 (openssl rand -hex 32). 한 번 정하면 바꾸지 말 것
BILLING_KEY_SECRET=

# 파일 저장소: local(서버 디스크) 또는 s3 (프로필 이미지·채팅 첨부·녹화)
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_PREFIX=prod
# IAM 사용자 키 (버킷 하나에만 GetObject/PutObject/DeleteObject 를 허용한 사용자 권장)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# mediasoup 워커 수 (CPU 코어 수 이하)
MEDIASOUP_WORKERS=2

# (선택) 백업을 S3 에도 올릴 때 (deploy/backup.sh). 서버에 aws CLI 설정이 필요하다
# BACKUP_S3_URI=s3://버킷이름/limeet

# AI 회의록·실시간 자막 (auto: Claude 키가 있으면 Claude, 없고 OLLAMA_URL 이 있으면 Ollama)
#   무료 Ollama: COMPOSE_PROFILES 에 ollama 를 넣고 OLLAMA_URL=http://ollama:11434
#   8GB 서버에서는 qwen2.5:3b 권장 (7b 는 메모리 약 5GB, CPU 로 요약이 몇 분). 자막은 CPU 로는 느려서 Claude 를 권장
AI_PROVIDER=auto
# 자막: CPU 의 Ollama 로는 실시간이 안 돼서 끈다 (Claude 키가 있으면 claude)
AI_CAPTION_PROVIDER=none
ANTHROPIC_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CAPTION_MODEL=
OLLAMA_MAX_CONTEXT=8192
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MEM_LIMIT=3g
OLLAMA_CPUS=1.0
