<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.webrtcmeetpro.infrastructure.meeting.MeetingMapper">

    <!-- idx_meetings_reminder (status, scheduled_at, reminder_sent_at) 를 탄다 -->
    <select id="findDueReminderIds" resultType="java.lang.Long">
        SELECT meeting_id
          FROM meetings
         WHERE status = #{status}
           AND reminder_sent_at IS NULL
           AND scheduled_at BETWEEN #{from} AND #{to}
    </select>
</mapper>
