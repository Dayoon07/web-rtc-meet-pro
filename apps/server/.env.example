# 로컬 개발용 비밀값 예시. 이 파일을 같은 폴더에 .env.local 로 복사해서 값을 채운다.
#   .env.local 은 .gitignore 에 있어 GitHub 에 올라가지 않는다 (이 .env.example 에는 값을 넣지 않는다)
#   서버(bootRun)가 시작할 때 자동으로 읽고, 같은 이름의 환경변수가 있으면 환경변수가 이긴다
#   비워 둔 기능은 꺼진 채로 서버가 뜬다 (예: 토스 키가 없으면 결제 버튼이 막힌다)
# 운영 배포용은 deploy/.env.example

# --- 토스페이먼츠 자동결제 (개발자센터 → API 키 → "API 개별 연동 키". test_ 로 시작하면 실제로 돈이 나가지 않는다) ---
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 카드 빌링키 암호화 비밀값 (openssl rand -hex 32). 비우면 JWT_SECRET 에서 만든다
BILLING_KEY_SECRET=

# --- 파일 저장소: local(서버 디스크) 또는 s3 (프로필 이미지·채팅 첨부·회의 녹화) ---
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=ap-northeast-2
# 버킷 안 폴더 (dev / prod)
S3_PREFIX=dev
# IAM 사용자 키 (그 버킷에 GetObject·PutObject·DeleteObject 만 허용한 사용자 권장)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI 회의록 (실시간 자막·번역은 꺼 둠: LIVE_CAPTIONS_ENABLED=false, 켜려면 true + 번역 AI) ---
# 무료: Ollama 를 설치하고 `ollama pull qwen2.5:7b` 후 `ollama serve`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 유료(선택): Claude API 키가 있으면 회의록을 Claude 로 (auto 일 때 키가 먼저)
ANTHROPIC_API_KEY=
AI_PROVIDER=auto
LIVE_CAPTIONS_ENABLED=false

# --- 웹 푸시 (브라우저를 닫아도 알림). python scripts/vapid-keys.py 로 한 번 만든다 ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# --- 메일 (가입 인증·비밀번호 재설정·팀 초대). 비우면 메일 대신 서버 로그에 링크를 찍는다 ---
# Gmail: smtp.gmail.com / 587 / 구글 계정의 "앱 비밀번호" (2단계 인증 필요)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true

# --- 구글 로그인 (비우면 구글 버튼이 꺼진다). 승인된 리디렉션 URI: http://localhost:5173/login/oauth2/code/google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
